+// Copyright (C) 2026 VCMI Project
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#ifndef QRHIDCOMP_P_H
+#define QRHIDCOMP_P_H
+
+// Qt's D3D RHI stores DirectComposition COM interface pointers even when the
+// runtime feature is unavailable. The Windows SDK hides those declarations
+// when targeting Windows 7. Temporarily expose declarations from dcomp.h while
+// preserving the Win7 target macros for every actual source file.
+#if defined(NTDDI_VERSION) && NTDDI_VERSION < 0x06020000
+#  pragma push_macro("NTDDI_VERSION")
+#  undef NTDDI_VERSION
+#  define NTDDI_VERSION 0x06020000
+#  define QT_RHI_RESTORE_NTDDI_VERSION
+#endif
+
+#include <dcomp.h>
+
+#ifdef QT_RHI_RESTORE_NTDDI_VERSION
+#  undef QT_RHI_RESTORE_NTDDI_VERSION
+#  pragma pop_macro("NTDDI_VERSION")
+#endif
+
+#endif // QRHIDCOMP_P_H
