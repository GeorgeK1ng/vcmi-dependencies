diff --git a/recipes/qt/6.x.x/conanfile.py b/recipes/qt/6.x.x/conanfile.py
index 2360ea166..b711fb79c 100644
--- a/recipes/qt/6.x.x/conanfile.py
+++ b/recipes/qt/6.x.x/conanfile.py
@@ -287,7 +287,10 @@ class QtConan(ConanFile):
             raise ConanInvalidConfiguration("apple-clang >= 13.1 is required by qt >= 6.6.1 cf QTBUG-119490")
 
         if self.settings.compiler == "msvc" and Version(self.settings.compiler.version) < "193":
-            raise ConanInvalidConfiguration("Visual Studio 2022 (MSVC 1930 or newer) is required by qt >= 6.8.3")
+            # VCMI uses the VS 2019 v142 toolchain (MSVC 19.29) for Windows 7 builds.
+            # Keep rejecting older compilers while allowing v142 for patched recipes.
+            if Version(self.settings.compiler.version) < "192":
+                raise ConanInvalidConfiguration("MSVC 1920 or newer is required by the VCMI legacy-Windows Qt recipe")
 
         if self.settings.compiler == "apple-clang" and Version(self.settings.compiler.version) < "15":
             raise ConanInvalidConfiguration("apple-clang >= 14 is required by qt >= 6.8.3")
@@ -489,5 +492,15 @@ class QtConan(ConanFile):
         tc.variables["QT_BUILD_TESTS"] = "OFF"
         tc.variables["QT_BUILD_EXAMPLES"] = "OFF"
 
+        if is_msvc(self) and Version(self.settings.compiler.version) == "192":
+            # Qt's build system has the same VS 2022 guard as this recipe. VCMI
+            # intentionally uses VS 2019 v142 for its Windows 7 package builds.
+            tc.variables["QT_NO_MSVC_MIN_VERSION_CHECK"] = "ON"
+
+        if self.version == "6.8.3" and is_msvc(self) and Version(self.settings.compiler.version) == "192":
+            # D3D11 has a DXGI 1.1 swapchain fallback in the source backport.
+            # D3D12 still depends on APIs that are unavailable on Windows 7.
+            tc.variables["FEATURE_d3d12"] = "OFF"
+
         if is_msvc(self) and "MT" in msvc_runtime_flag(self):
             tc.variables["FEATURE_static_runtime"] = "ON"
